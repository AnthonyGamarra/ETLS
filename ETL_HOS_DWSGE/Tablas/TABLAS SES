CREATE TABLE dwsge.dwe_hosp_egresos (
    cod_oricentro              VARCHAR(10),
    cod_centro                 VARCHAR(10),
    periodo                    VARCHAR(6),     -- yyyymm
    anio                       VARCHAR(4),
    cod_servicio               VARCHAR(20),
    cod_actividad              VARCHAR(20),
    cod_estacion               VARCHAR(20),
    cmp                        VARCHAR(20),
    cod_tipdoc_medico          VARCHAR(20),
    dni_medico                 VARCHAR(20),
    autogenerado               VARCHAR(30),
    cmame_pacsecnum            NUMERIC,
    cod_tipdoc_paciente        VARCHAR(20),
    doc_paciente               VARCHAR(20),
    anio_edad                  INTEGER,
    meses                      INTEGER,
    sexo                       VARCHAR(30),
    nro_hc                     VARCHAR(30),
    cod_tip_seguro             VARCHAR(10),
    cod_tipo_parentesco        VARCHAR(10),
    cod_tipo_paciente          VARCHAR(10),
    fec_ingr                   VARCHAR(30),
    hor_ingr                   VARCHAR(30),
    fec_altmed                 VARCHAR(30),
    hor_altmed                 VARCHAR(30),
    fec_egreso                 VARCHAR(30),
    hor_egreso                 VARCHAR(30),
    fech_reg                   VARCHAR(30),
    fech_modif                 VARCHAR(30),
    dias_hospit                VARCHAR(30),
    acto_med                   NUMERIC,
    cod_tipo_gravidez          VARCHAR(10),
    cod_motivo_egreso          VARCHAR(10),
    cuarto                     VARCHAR(10),
    cama                       VARCHAR(10),
    cod_tipo_cama              VARCHAR(10),
    cas_adscripcion            VARCHAR(10),
    cod_grupocup_altamed       VARCHAR(10),
    ultsecuenaten              NUMERIC,
    ubicacion                  VARCHAR(20),
    cod_centro_ref             VARCHAR(10),
    centro_ref                 VARCHAR(10),
    cod_cond_diag            VARCHAR(10),
    diag_cod                 VARCHAR(20),
    tipo_diag_cod            VARCHAR(10)

) PARTITION BY LIST (ANIO)

