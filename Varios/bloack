SELECT 
    redasisdes,
    doc_paciente,
    TO_CHAR(MIN(fecha_min), 'DD/MM/YYYY') AS fecha_min
FROM (
    -- PRIMERA TABLA
    SELECT
        redasisdes,
        a.doc_paciente,
        MIN(a.fecha_atencion::date) AS fecha_min
    FROM dwsge.dwe_consulta_externa_homologacion_2025 a
    LEFT JOIN dssge.sgss_cbtpc10 t ON t.tipopacicod= a.cod_tipo_paciente
    LEFT JOIN dwsge.sgss_cmcas10 c 
        ON c.cenasicod = a.cod_centro 
       AND c.oricenasicod = a.cod_oricentro
	LEFT JOIN dwsge.sgss_cmras10 rs 
		ON rs.redasiscod = c.redasiscod
    WHERE a.cas_adscripcion = a.cod_centro
    GROUP BY 
        redasisdes,
        a.doc_paciente

    UNION ALL

    -- SEGUNDA TABLA
    SELECT 
        redasisdes,
        a.doc_paciente,
        MIN(a.fecha_atencion::date) AS fecha_min
    FROM dssge.dw_nomed_2025 a
    LEFT JOIN dwsge.sgss_cmcas10 c 
        ON c.cenasicod = a.cod_centro 
       AND c.oricenasicod = a.cod_oricentro
    LEFT JOIN dssge.sgss_cbtpc10 t ON t.tipopacicod= a.cod_tipo_paciente
	LEFT JOIN dwsge.sgss_cmras10 rs 
		ON rs.redasiscod = c.redasiscod
    GROUP BY 
        redasisdes,
        a.doc_paciente
    
	UNION ALL

	-- TERCERA TABLA
    SELECT 
        redasisdes,
        a.doc_paciente,
        MIN(a.fecha_atencion::date) AS fecha_min
    FROM dssge.dw_odonto_2025 a
    LEFT JOIN dwsge.sgss_cmcas10 c 
        ON c.cenasicod = a.cod_centro 
       AND c.oricenasicod = a.cod_oricentro
    LEFT JOIN dssge.sgss_cbtpc10 t ON t.tipopacicod= a.cod_tipo_paciente
	LEFT JOIN dwsge.sgss_cmras10 rs 
			ON rs.redasiscod = c.redasiscod
    GROUP BY 
        redasisdes,
        a.doc_paciente

	UNION ALL

	-- CUARTA TABLA
            SELECT
		        redasisdes,
		        doc_paciente,
		        fecha_aten::date AS fecha_atencion
            FROM (
