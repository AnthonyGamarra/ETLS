CREATE TABLE dssge.dw_lab (
            ANIO char(4),
            PERIODO char(6) ,
            COD_ORICENTRO varchar(10),
            cod_CENTRO varchar(10),
            cod_AREALAB varchar(20),
            cod_AREA varchar(20),
            COD_SERVICIO varchar(20),
            COD_ACTIVIDAD varchar(20),
            COD_SUBACTIVIDAD varchar(20),
            COD_PACIENTE varchar(20),
            SEXO varchar(20),
            ANIO_EDAD varchar(20),
            CAS_ADSCRIPCION varchar(20),
            EXAMEN varchar(50),
            ORDEN_PLANTILLA varchar(50),
            UNIDADVALOR varchar(50),
            VALORESMASCULINO varchar(100),
            VALORESFEMENINO varchar(100),                                       
            VALORES_OTROS varchar(100)
) PARTITION BY LIST (ANIO);

