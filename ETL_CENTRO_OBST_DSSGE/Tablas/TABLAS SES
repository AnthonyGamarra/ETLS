CREATE TABLE dssge.dwe_centro_obstetrico
 (
        COD_ORICENTRO  varchar(10),
        COD_CENTRO varchar(10),
        ANIO varchar(4),
        PERIODO varchar(6),	
        FECHATENCION date,
        HORATENCION time,
        ACTO_MED numeric,
        COD_TIPDOC_PACIENTE varchar(10),
        DOC_PACIENTE varchar(20),
        COD_SERVICIO varchar(10),
        COD_EST_ENFER varchar(10),
        ANNOS varchar(10),
        SEXO varchar(1),
        H_C numeric,
        COD_TIP_SEGURO varchar(10),
        COD_TIPO_PARENTESCO varchar(10),
        COD_TIPO_PACIENTE varchar(10),
        COD_GRUPO_CUPACIONAL varchar(10),
        CPMS varchar(10),
        DOC_MEDICOL varchar(20),
        COD_DIAG varchar(10),
        COD_COND_TRAB varchar(10)
    ) PARTITION BY LIST (anio);

-- Crear partición anual para 2025
