WITH atenciones AS (
	SELECT
		u.cod_oricentro,
		u.cod_centro,
		u.cod_area,
		u.cod_servicio,
		u.cod_actividad,
		u.cod_subactividad,
		u.cod_tipdoc_medico,
		u.cod_doc_medico,
		u.fecha_cita,
		u.horaini,
		u.horafin,
		COUNT(*) AS ate
	FROM 
		dssge.sgss_ctcam10_m u
	WHERE 
		u.cod_estado_cita = '4'
	GROUP BY
		u.cod_oricentro,
		u.cod_centro,
		u.cod_area,
		u.cod_servicio,
		u.cod_actividad,
		u.cod_subactividad,
		u.cod_tipdoc_medico,
		u.cod_doc_medico,
		u.fecha_cita,
		u.horaini,
